require "base64"

ROOT = File.expand_path("..", __dir__)
IOS_ROOT = File.join(ROOT, "apps/ios")
DESKTOP_ROOT = File.join(ROOT, "apps/desktop")
OUTPUT_DIR = File.join(ROOT, "build/fastlane")
TEAM_ID = "N2C267LBVY"
MATCH_GIT_URL = "https://github.com/devxoul/unteams-match.git"
RELEASE_NOTES = File.join(__dir__, "release_notes.txt")

IOS_APP_ID = "app.unteams.ios"
MAC_APP_ID = "app.unteams.mac"

EXTERNAL_TESTER_GROUP = "Beta Testers"
BETA_APP_DESCRIPTION = <<~TEXT.strip
  Unteams is a lightweight wrapper around the Microsoft Teams web app.

  To test, sign in with a Microsoft work or school account, then check that chats, channels and calls load and work.
TEXT

# Beta App Review contact. The email is also the testers' feedback address.
BETA_CONTACT = {
  contact_first_name: "Suyeol",
  contact_last_name: "Jeon",
  contact_email: "devxoul@gmail.com",
  contact_phone: ENV["APP_REVIEW_PHONE_NUMBER"].to_s.empty? ? nil : ENV["APP_REVIEW_PHONE_NUMBER"],
  # Teams accounts belong to an organization's Microsoft 365 tenant, so there's no demo account to share.
  demo_account_required: false,
  notes: <<~TEXT.strip
    Unteams wraps Microsoft Teams on the web (teams.cloud.microsoft). Teams accounts belong to an organization's Microsoft 365 tenant and can't be shared, so no demo account is provided.

    Any Microsoft work or school account with Teams access can sign in. Without one, the app shows Microsoft's sign-in page, which is the expected first screen.
  TEXT
}.compact

PROJECT_SWIFT = File.join(IOS_ROOT, "Project.swift")
PACKAGE_JSON = File.join(DESKTOP_ROOT, "package.json")
IOS_VERSION_PATTERN = /("CFBundleShortVersionString": ")([^"]+)(")/
MAC_VERSION_PATTERN = /("version": ")([^"]+)(")/

before_all do
  # Temporary keychain + readonly match on CI runners.
  setup_ci if is_ci
end

desc "Set the version in Project.swift and the desktop package.json and commit it"
lane :bump do |options|
  version = options[:version].to_s
  UI.user_error!("Usage: fastlane bump version:X.Y.Z") unless version.match?(/\A\d+\.\d+\.\d+\z/)

  files = { PROJECT_SWIFT => IOS_VERSION_PATTERN, PACKAGE_JSON => MAC_VERSION_PATTERN }
  files.each do |path, pattern|
    content = File.read(path)
    UI.user_error!("Couldn't find the version in #{path}") unless content.match?(pattern)
    File.write(path, content.sub(pattern, "\\1#{version}\\3"))
  end

  if sh("git", "-C", ROOT, "status", "--porcelain", *files.keys).strip.empty?
    UI.important("Already at #{version}, nothing to commit")
    next
  end
  git_commit(path: files.keys, message: "Bump version to #{version}")
end

desc "Release both apps: the notarized Mac app in build/fastlane/, the iPhone app to TestFlight"
lane :release do
  api_key = app_store_connect_api_key
  # Mac first: it has no public side effect, so most failures happen before the TestFlight upload.
  build_mac(api_key)
  build_ios(api_key)
end

platform :ios do
  desc "Build the iPhone app and upload it to TestFlight"
  lane :beta do
    build_ios(app_store_connect_api_key)
  end
end

platform :mac do
  desc "Build the Electron app with Developer ID, notarize it, and copy the zip and dmg to build/fastlane/"
  lane :release do
    build_mac(app_store_connect_api_key)
  end
end

def build_ios(api_key)
  build_number = latest_testflight_build_number(api_key: api_key, app_identifier: IOS_APP_ID, initial_build_number: 0) + 1
  ENV["TUIST_BUILD_NUMBER"] = build_number.to_s
  sh("cd #{IOS_ROOT.shellescape} && tuist generate --no-open")

  match(type: "appstore", platform: "ios", git_url: MATCH_GIT_URL, app_identifier: [IOS_APP_ID], api_key: api_key)
  # build_mac's match leaves the Mac app mapped to nil, which gym passes to -exportOptionsPlist and xcodebuild rejects.
  lane_context[SharedValues::MATCH_PROVISIONING_PROFILE_MAPPING].delete(MAC_APP_ID)
  update_code_signing_settings(
    path: File.join(IOS_ROOT, "Unteams.xcodeproj"),
    targets: ["UnteamsiOS"],
    use_automatic_signing: false,
    team_id: TEAM_ID,
    code_sign_identity: "Apple Distribution",
    profile_name: lane_context[SharedValues::MATCH_PROVISIONING_PROFILE_MAPPING][IOS_APP_ID]
  )

  build_app(
    workspace: File.join(IOS_ROOT, "Unteams.xcworkspace"),
    scheme: "UnteamsiOS",
    configuration: "Production",
    export_method: "app-store",
    output_directory: OUTPUT_DIR
  )

  changelog = File.exist?(RELEASE_NOTES) ? File.read(RELEASE_NOTES).strip : ""
  upload_to_testflight(
    api_key: api_key,
    changelog: changelog.empty? ? nil : changelog,
    # Beta App Review rejects external submissions without test information and a contact.
    # Keyed by locale rather than beta_app_description: pilot only patches existing localizations with the latter,
    # and creates one only for a locale named here, so the first external submission doesn't fail as "missing".
    localized_app_info: {
      "en-US" => { description: BETA_APP_DESCRIPTION, feedback_email: BETA_CONTACT[:contact_email] }
    },
    beta_app_review_info: BETA_CONTACT,
    # External groups need a processed build, so wait for it and submit it for beta review.
    distribute_external: true,
    groups: [EXTERNAL_TESTER_GROUP],
    notify_external_testers: true
  )
end

def build_mac(api_key)
  # Installs the Developer ID certificate into the keychain, where electron-builder finds it.
  # Electron needs no provisioning profile, and only the Account Holder can create Developer ID ones.
  match(type: "developer_id", platform: "macos", git_url: MATCH_GIT_URL, app_identifier: [MAC_APP_ID], api_key: api_key, skip_provisioning_profiles: true)

  # electron-builder notarizes with the same App Store Connect API key, read from a .p8 file.
  key_path = File.join(OUTPUT_DIR, "AuthKey.p8")
  FileUtils.mkdir_p(OUTPUT_DIR)
  key = api_key[:is_key_content_base64] ? Base64.decode64(api_key[:key]) : api_key[:key]
  File.write(key_path, key)
  begin
    sh(
      {
        "APPLE_API_KEY" => key_path,
        "APPLE_API_KEY_ID" => api_key[:key_id],
        "APPLE_API_ISSUER" => api_key[:issuer_id],
        "CSC_IDENTITY_AUTO_DISCOVERY" => "true"
      },
      "cd #{DESKTOP_ROOT.shellescape} && bun run release"
    )
  ensure
    File.delete(key_path)
  end

  version = File.read(PACKAGE_JSON)[MAC_VERSION_PATTERN, 2]
  %w[zip dmg].each do |ext|
    FileUtils.cp(File.join(DESKTOP_ROOT, "release/Unteams-#{version}.#{ext}"), File.join(OUTPUT_DIR, "Unteams-#{version}.#{ext}"))
  end
  generate_appcast(version)
end

# Writes build/fastlane/appcast.xml for the GitHub Release; the app's feed URL follows the latest release.
# Signs with SPARKLE_PRIVATE_KEY on CI, or the `app.unteams` keychain item from `generate_keys` locally.
def generate_appcast(version)
  archives = File.join(OUTPUT_DIR, "appcast")
  FileUtils.rm_rf(archives)
  FileUtils.mkdir_p(archives)
  FileUtils.cp(File.join(OUTPUT_DIR, "Unteams-#{version}.zip"), archives)

  tool = File.join(DESKTOP_ROOT, "vendor/Sparkle/bin/generate_appcast").shellescape
  key = ENV["SPARKLE_PRIVATE_KEY"].to_s.empty? ? "--account app.unteams" : "--ed-key-file -"
  command = [
    tool, key,
    "--download-url-prefix", "https://github.com/devxoul/unteams/releases/download/#{version}/",
    "-o", File.join(OUTPUT_DIR, "appcast.xml").shellescape,
    archives.shellescape
  ].join(" ")
  command = %(printf '%s' "$SPARKLE_PRIVATE_KEY" | #{command}) unless ENV["SPARKLE_PRIVATE_KEY"].to_s.empty?
  sh(command)
end
